{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimblogic.github.io/agent-resources/qa-cases.schema.json",
  "title": "JimBLogic source-selection fixtures 1.0",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://jimblogic.github.io/agent-resources/qa-cases.schema.json",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "tested_behavior": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_on": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "status": {
          "const": "NOT TESTED",
          "type": "string"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "note"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "expected_source_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "avoid": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "prompt",
          "expected_source_id",
          "avoid",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "purpose",
    "tested_behavior",
    "reviewed_on",
    "evaluation",
    "cases"
  ],
  "additionalProperties": false
}
